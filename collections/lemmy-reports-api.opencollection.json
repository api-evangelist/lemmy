{
  "opencollection": "1.0.0",
  "info": {
    "name": "Lemmy REST Account Reports API",
    "version": "4.0.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Reports",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Report a post",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://lemmy.world/api/v4/post/report",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Submit a report for a post to the instance moderators."
        },
        {
          "info": {
            "name": "Report a comment",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://lemmy.world/api/v4/comment/report",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Submit a report for a comment to the instance moderators."
        },
        {
          "info": {
            "name": "List reports",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://lemmy.world/api/v4/report/list",
            "params": [
              {
                "name": "page",
                "value": "",
                "type": "query"
              },
              {
                "name": "limit",
                "value": "",
                "type": "query"
              },
              {
                "name": "community_id",
                "value": "",
                "type": "query"
              },
              {
                "name": "unresolved_only",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "Retrieve a list of content reports. Requires moderator or admin."
        }
      ]
    }
  ],
  "bundled": true
}