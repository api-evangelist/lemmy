{
  "opencollection": "1.0.0",
  "info": {
    "name": "Lemmy REST Account Images API",
    "version": "4.0.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Images",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Upload an image",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://lemmy.world/api/v4/image",
            "body": {
              "type": "multipart-form",
              "data": [
                {
                  "name": "images[]",
                  "type": "text",
                  "value": ""
                }
              ]
            }
          },
          "docs": "Upload an image file to the instance's image storage."
        },
        {
          "info": {
            "name": "Get an image",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://lemmy.world/api/v4/image/:filename",
            "params": [
              {
                "name": "filename",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Retrieve an uploaded image by filename."
        },
        {
          "info": {
            "name": "Proxy an external image",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://lemmy.world/api/v4/image/proxy",
            "params": [
              {
                "name": "url",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "Proxy and optionally cache an external image through this instance."
        }
      ]
    }
  ],
  "bundled": true
}